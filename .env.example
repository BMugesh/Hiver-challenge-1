# SupportDNA Environment Configuration Example
# Copy this file to .env and configure your environment variables.

# ==============================================================================
# PostgreSQL Live Conversation Memory
# ==============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=supportdna
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# Optional direct connection string override (e.g. postgresql://user:pass@localhost:5432/supportdna)
# DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/supportdna

# ==============================================================================
# Model & Security API Keys (Optional)
# ==============================================================================
# GROQ_API_KEY=
# OPENAI_API_KEY=
